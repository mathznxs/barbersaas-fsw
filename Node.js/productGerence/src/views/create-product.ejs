<!DOCTYPE html>

<html lang="pt-BR"> 
    <head> 
        <meta charset="UTF-8"> 
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Cadastrar Produto</title>
    </head>
    <body>
        <h1>Criar Produto</h1>
        <main>
            <form action="/products/new" method="POST">
                <label for="name">Nome: </label>
                <input type="text" name="name" placeholder="Digite seu nome: " id="name" required >
                <br><br>
                <label for="description">Descrição</label>
                <textarea name="description" id="description" required></textarea><br><br>
                <label for="category">Categoria: </label>
                <input type="text" name="category" placeholder="Categoria" id="category" required><br><br>
                <label for="category">Preço: R$</label>
                <input type="number" name="price" id="price" placeholder="00.0" step="0.01" required>
                <br><br>
                <label for="category">Quantidade: </label>
                <input type="number" name="quantity" id="quantity" required>
                <button type="submit">Cadastrar</button>
            </form>
        </main>    
    </body>
</html>